---
import Layout from '../../layouts/Layout.astro'

const slmvideo = [
  {
    name: "Why SLM",
    imageSrc: "/images/thumbnail-image.jpeg",
  },
  {
    name: "SLM mechanical Factory",
    imageSrc: "/images/thumbnail-image.jpeg",
  },
  {
    name: "SLM Galvanizing Factory",
    imageSrc: "/images/thumbnail-image.jpeg",
  },
  {
    name: "SLM Rubber Factory",
    imageSrc: "/images/thumbnail-image.jpeg",
  },
 
];
const productvideo = [
  {
    name: "Sail-boat Stand",
    imageSrc: "/images/thumbnail-image.jpeg",
  },
  {
    name: "Moto Boat Stand",
    imageSrc: "/images/thumbnail-image.jpeg",
  },
  {
    name: "Keel Stand",
    imageSrc: "/images/thumbnail-image.jpeg",
  },
  {
    name: "Helican Scerews",
    imageSrc: "/images/thumbnail-image.jpeg",
  },
 
];
const techvideo = [
  {
    name: "Robot welding technology",
    imageSrc: "/images/thumbnail-image.jpeg",
  },
  {
    name: "Laser cutting technology",
    imageSrc: "/images/thumbnail-image.jpeg",
  },
  {
    name: "Hot-dip galvanized",
    imageSrc: "/images/thumbnail-image.jpeg",
  },
  {
    name: "Rubber extrusion technology",
    imageSrc: "/images/thumbnail-image.jpeg",
  },
 
];
---

<Layout title="Media">
   
    <div class="bg-slate-100 py-16 sm:py-6">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="mx-auto max-w-2xl lg:mx-0">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">About SLM</h2>
            <!-- <p class="mt-6 text-lg leading-8 text-gray-600">We're a dynamic group of individuals who are passionate about what we do and dedicated to delivering the best results for our clients.</p> -->
          </div>
          <ul role="list" class="mx-auto mt-6 grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-4">
            {slmvideo.map(video => (
                <li >
                  <img class="aspect-[3/2] w-full object-cover" src={video.imageSrc} alt={video.name} />
                  <div class="bg-white py-3 px-3">
                  <h3 class="text-lg font-semibold leading-8 tracking-tight text-gray-900">{video.name}</h3>
                </div>
                </li>
                
              ))}
      
          </ul>
        </div>
      </div>
    <div class="bg-slate-100 py-16 sm:py-6">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="mx-auto max-w-2xl lg:mx-0">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">About Our Products</h2>
            <!-- <p class="mt-6 text-lg leading-8 text-gray-600">We're a dynamic group of individuals who are passionate about what we do and dedicated to delivering the best results for our clients.</p> -->
          </div>
          <ul role="list" class="mx-auto mt-6 grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-4">
            {productvideo.map(video => (
                <li >
                  <img class="aspect-[3/2] w-full object-cover" src={video.imageSrc} alt={video.name} />
                  <div class="bg-white py-3 px-3">
                  <h3 class="text-lg font-semibold leading-8 tracking-tight text-gray-900">{video.name}</h3>
                </div>
                </li>
                
              ))}
      
          </ul>
        </div>
      </div>
    <div class="bg-slate-100 py-16 sm:py-6">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="mx-auto max-w-2xl lg:mx-0">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">About the Technology</h2>
            <!-- <p class="mt-6 text-lg leading-8 text-gray-600">We're a dynamic group of individuals who are passionate about what we do and dedicated to delivering the best results for our clients.</p> -->
          </div>
          <ul role="list" class="mx-auto mt-6 grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-4">
            {techvideo.map(video => (
                <li >
                  <img class="aspect-[3/2] w-full object-cover" src={video.imageSrc} alt={video.name} />
                  <div class="bg-white py-3 px-3">
                  <h3 class="text-lg font-semibold leading-8 tracking-tight text-gray-900">{video.name}</h3>
                </div>
                </li>
                
              ))}
      
          </ul>
        </div>
      </div>
      
</Layout>
