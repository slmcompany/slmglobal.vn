<AstroSeo title="Qualiti - Professional - Trust" description=" ." />

<Layout title="Qualiti - Professional - Trust">
    <div class="relative w-full h-screen lg:hidden">
        <img
            src="/images/background-globle.png"
            alt="Fallback"
            class="absolute top-0 left-0 w-full h-full object-bottom object-cover"
        />

        <div class="absolute inset-0 z-1 top-20 pl-4 pr-20">
            <img
                src="/images/made-in-vietnam.png"
                alt="Fallback"
                class="h-16"
            />
            <h1 class="text-red-700 text-6xl pt-2">Global<br /> Presence</h1>
            <p class=" text-xl pt-2 pr-6">
                Our products have a global presence, with exports to the USA,
                France, Sweden, Australia, and Japan.
            </p>
            <div
                class="h-12 flex-col justify-center items-center gap-2.5 inline-flex"
            >
                <div
                    class="self-stretch py-3 rounded-lg justify-start items-center gap-2 inline-flex pt-10"
                >
                    <div class="w-6 h-6 p-0.5 justify-center items-center flex">
                        <div
                            class="w-6 h-6 relative flex flex-grow items-center rounded-full border-black border-2"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="4"
                                stroke="currentColor"
                                class="size-5 "
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="text-xl font-semibold">
                        <a href="/products" class="underline">
                            Explore All Products
                        </a>
                    </div>
                </div>
            </div>
            <div class="relative">
                <img
            src="/images/screw-device.png"
            alt="Fallback"
            class="absolute top-0 left-1/2 -translate-x-1/2 w-60 object-bottom object-cover"
        />
            </div>
        </div>
    </div>

    <div class="relative isolate overflow-hidden pt-14 sm:hidden hidden xl:block">
      
        <img src="/images/transport-logistics-products.jpg" alt="" class="absolute inset-0 -z-10 h-full w-full object-cover">
        <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
          <div class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
        </div>
        
        
        <div class=" mx-auto max-w-2xl py-32 sm:py-48 lg:py-56">
       
          <div class="text-center">
            <h1 class="text-balance text-4xl font-bold tracking-tight  sm:text-6xl text-red-700">Global Presence</h1>
            <p class="mt-6 text-lg leading-8 text-gray-800">Our products have a global presence, with exports to the USA, France, Sweden, Australia, and Japan.</p>
            <div class="mt-10 flex items-center justify-center gap-x-6">
              <a href="#" class="rounded-md bg-red-700 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400">Explore All Products</a>
            
            </div>
          </div>
        </div>
        <div class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]" aria-hidden="true">
          <div class="relative left-[calc(50%+3rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
        </div>
      </div>

    <Featureproduct products={products} featuretitle={featuretitle} />

