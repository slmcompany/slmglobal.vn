---
import Layout from '../../../layouts/Layout.astro'

import Image from 'astro/components/Image.astro'

const Products = Astro.props
const baseUrl = import.meta.env.STRAPI_URL

const product = {
	title: 'Thread Screw F Series',
	description:
		'F-series Threaded Screw anchors are designed with round flange heads or squares to support the upper structural frame. Spiral screw parts are welded along the pipe body, and the anchor can also drill deep into the ground a simple construction process helps shorten the time and save costs cost increases stability, and is suitable for hard soils and gravel rock. The product is made from SS400, Q235, and Q345 steel, and hot-dip galvanizing ac- cording to ASTM A123 standards helps the product have good bearing capacity, high durability, and a long life span of up to 30 years.',
	specifications: [
		{
			title: 'TF-1000',
			length: '1,000',
			pipeSize: '76.10',
			weight: '6.56',
			steelGrade: 'STK400/500; SS400; Q345',
			surface: 'Hot-dip galvanized'
		},
		{
			title: 'TF-1500',
			length: '1,500',
			pipeSize: '76.10',
			weight: '9.84',
			steelGrade: 'STK400/500; SS400; Q345',
			surface: 'Hot-dip galvanized'
		},
		{
			title: 'TF-2000',
			length: '2,000',
			pipeSize: '76.10',
			weight: '13.13',
			steelGrade: 'STK400/500; SS400; Q345',
			surface: 'Hot-dip galvanized'
		}
	],
	connectionHead: [
		'/images/thread-screw-f-series/f-series-thread-screw-connect-head_1.png',
		'/images/thread-screw-f-series/f-series-thread-screw-connect-head_2.png',
		'/images/thread-screw-f-series/f-series-thread-screw-connect-head_3.png'
	],
	finishing: ['Hot-dip', 'Logo painting', 'Packing'],
	accessories: ['Bolts', 'Rubber gaskets'],
	applications: ['Solar panel support', 'Fences', 'Transportation', 'Garden'],
	mainImage: '/images/thread-screw-f-series/f-series-thread-screw-main.png',
	images: [
		'/images/thread-screw-f-series/f-series-thread-screw-1.png',
		'/images/thread-screw-f-series/f-series-thread-screw-2.png',
		'/images/thread-screw-f-series/f-series-thread-screw-3.jpg',
		'/images/thread-screw-f-series/f-series-thread-screw-4.jpg',
		'/images/thread-screw-f-series/f-series-thread-screw-5.jpg',
		'/images/thread-screw-f-series/f-series-thread-screw-6.jpg',
		'/images/thread-screw-f-series/f-series-thread-screw-7.jpg',
		'/images/thread-screw-f-series/f-series-thread-screw-8.jpg'
	]
}

const title = 'ProduThread Screw F Series'
---

<Layout title={product.title}>
	<div class="bg-white pt-14 sm:pt-10 md:pt-10 lg:pt-10">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col lg:flex-row">
				<div class="lg:w-5/12">
					<div class="w-full">
						<h2 class="text-2xl font-bold">{product.title}</h2>
						<p class="text-md text-justify text-gray-700">
							{product.description}
						</p>
						<div class="mt-4 overflow-x-auto">
							<table class="mt-4 min-w-full divide-y divide-gray-200">
								<thead class="bg-red-700">
									<tr class="p-2">
										<th scope="col" class="px-2 text-left uppercase tracking-wider text-white"
											>Specifications</th
										>
										{
											product.specifications.map((spec) => (
												<th scope="col" class="text-left uppercase tracking-wider text-red-700">
													<span class="rounded-md bg-white px-2">{spec.title}</span>
												</th>
											))
										}
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-200 bg-white">
									<tr>
										<td class="whitespace-nowrap text-gray-900">Length (mm)</td>
										{
											product.specifications.map((spec) => (
												<td class="whitespace-nowrap">{spec.length}</td>
											))
										}
									</tr>
									<tr>
										<td class="whitespace-nowrap text-gray-900">Pipe size (mm)</td>
										{
											product.specifications.map((spec) => (
												<td class="whitespace-nowrap">{spec.pipeSize}</td>
											))
										}
									</tr>
									<tr>
										<td class="whitespace-nowrap text-gray-900">Weight (kg)</td>
										{
											product.specifications.map((spec) => (
												<td class="whitespace-nowrap">{spec.weight}</td>
											))
										}
									</tr>
									<tr>
										<td class="whitespace-nowrap text-gray-900">Steel grade</td>
										<td colspan={product.specifications.length} class="whitespace-nowrap"
											>{product.specifications[0].steelGrade}</td
										>
									</tr>
									<tr>
										<td class="whitespace-nowrap text-gray-900">Surface</td>
										<td colspan={product.specifications.length} class="whitespace-nowrap"
											>{product.specifications[0].surface}</td
										>
									</tr>
								</tbody>
							</table>
						</div>
						<div>
							<h2 class="mt-4 block w-full bg-red-700 px-2 font-bold uppercase text-white">
								Connection head
							</h2>
							<div class="mt-4 flex flex-nowrap justify-between gap-4 rounded-md">
								{
									product.connectionHead.map((image, index) => (
										<div class="w-1/3">
											<img
												src={image}
												class="aspect-[1/1] h-full w-full rounded-full object-cover"
											/>
										</div>
									))
								}
							</div>
						</div>
						<div class="mt-4 flex flex-wrap justify-between rounded-md bg-slate-100 p-2">
							<div class="w-full text-left sm:w-1/3">
								<h2 class="font-bold text-red-700">Finishing</h2>
								<ul class="list-inside list-disc text-base">
									{product.finishing.map((item, index) => <li>{item}</li>)}
								</ul>
							</div>
							<div class="w-full text-left sm:w-1/3">
								<h2 class="font-bold text-red-700">Accessories</h2>
								<ul class="list-inside list-disc text-base">
									{product.accessories.map((item, index) => <li>{item}</li>)}
								</ul>
							</div>
							<div class="w-full text-left sm:w-1/3">
								<h2 class="font-bold text-red-700">Applications</h2>
								<ul class="list-inside list-disc text-base">
									{product.applications.map((item, index) => <li>{item}</li>)}
								</ul>
							</div>
						</div>
					</div>
				</div>
				<div class="mt-4 flex w-full justify-center lg:mt-0 lg:w-2/12">
					<img
						src={product.mainImage}
						class="h-1/2 w-1/2 rounded-md object-contain sm:max-h-screen lg:h-1/2"
					/>
				</div>
				<div class="mt-4 flex h-full w-full flex-wrap justify-start lg:mt-0 lg:w-5/12">
					{
						product.images.map((image: any, index: number) => (
							<div class="w-1/2 p-2">
								<img src={image} class="aspect-[3/2] rounded-md object-cover" />
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</Layout>
