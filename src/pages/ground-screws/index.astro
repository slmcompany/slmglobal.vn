---
import Layout from "../../layouts/Layout.astro";
import { AstroSeo } from "@astrolib/seo";
import fetchApi from "../../lib/strapi.ts";
import type Products from "../../interfaces/products.ts";
import Featureproduct from "../../components/Featureproduct.astro";
import Image from "astro/components/Image.astro";
import Headercategory from "../../components/Headercategory.astro";
import Certificate from "../../components/Certificate.astro";

const Products = await fetchApi<Products[]>({
    endpoint:
        "products?populate=feature_image&populate[1]=highlight&filters[$and][0][category][$eq]=screw",
    wrappedByKey: "data", // the key to unwrap the response
});

const featuretitle = "Feature Products";
const products = [
    {
        title: "THREAD SCREWS",
        imageSrc: "/images/t-screw.jpg",

        price: "$ 6.63/KGS",
        link: "/ground-screws/thread-screws",
        highlight: [
            { text: "Weight (KGS):", value: "Min 4.42" },
            { text: "Welding method:", value: "Automatic Robot" },
            { text: "Plating method:", value: "Hot-dip galvanized" },
        ],
    },
    {
        title: "HELICAL SCREWS",
        imageSrc: "/images/h-screw.jpg",
        price: "$ 8.84/KGS",
        link: "/ground-screws/helical-screws",
        highlight: [
            { text: "Weight (KGS):", value: "Min 4.42" },
            { text: "Welding method:", value: "Automatic Robot" },
            { text: "Plating method:", value: "Hot-dip galvanized" },
        ],
    },
];
---

<AstroSeo title="Quartz stone" description=" ." />

<Layout title="Quartz stone">
    <div class="relative bg-red-700">
        <div class="mx-auto max-w-7xl lg:grid lg:grid-cols-12 lg:gap-x-8 lg:px-8">
          <div class="px-6 pb-24 pt-10 sm:pb-32 lg:col-span-7 lg:px-0 lg:pb-56 lg:pt-48 xl:col-span-6">
            <div class="mx-auto max-w-2xl lg:mx-0">
             
              <h1 class="mt-24 text-4xl font-bold tracking-tight text-white sm:mt-10 sm:text-6xl">Ground screws            </h1>
              <p class="mt-6 text-lg leading-8 text-white">Ground screws are an efficient foundation solutionfor various construction projects. They are quickly installed by being screwed into the ground, providing strong support for structures like decks, fences and solar panels. Ground screws reduce excavation needs, minimize soil disruption, and are less affected by weather conditions compared to traditional concrete foundations, saving both time and costs.</p>
              
            </div>
          </div>
          <div class="relative lg:col-span-5 lg:-mr-8 xl:absolute xl:inset-0 xl:left-1/2 xl:mr-0">
            <img class="aspect-[3/2] w-full bg-gray-50 object-cover lg:absolute lg:inset-0 lg:aspect-auto lg:h-full" src="/images/growscrew.png" alt="">
          </div>
        </div>
      </div>
   
    <!-- <Headercategory
        title="Ground screws"
        content=" Ground screws are an efficient foundation solutionfor various construction projects. They are quickly installed by being screwed into the ground, providing strong support for structures like decks, fences and solar panels. Ground screws reduce excavation needs, minimize soil disruption, and are less affected by weather conditions compared to traditional concrete foundations, saving both time and costs."
        imglink="/images/header-screw-banner.png"
    /> -->
   
    <div class="bg-slate-100 py-24 sm:py-12">
        <div class="mx-auto max-w-7xl px-4 lg:px-8">
            <div class="mx-auto max-w-2xl lg:mx-0 lg:hidden xl:hidden">
                <div class="h-12 justify-between items-center flex">
                    <div
                        class="p-3 bg-white rounded-lg border border-gray-200 justify-start items-center gap-4 flex"
                    >
                        <div class="justify-start items-center gap-2 flex">
                            <div
                                class="w-7 h-7 px-1 pt-1 pb-[3px] justify-center items-center flex"
                            >
                                <img
                                    src="/images/tabler_filter.svg"
                                    alt="filter"
                                />
                            </div>
                            <div
                                class="text-center text-gray-700 text-base font-medium leading-normal"
                            >
                                Filter
                            </div>
                        </div>
                    </div>
                    <div
                        class="p-3 bg-white rounded-lg border border-gray-200 justify-start items-center gap-4 flex"
                    >
                        <div class="justify-start items-center gap-2 flex">
                            <div
                                class="w-6 h-6 px-[3px] py-1.5 justify-center items-center flex"
                            >
                                <img
                                    src="/images/ic_round-sort.svg"
                                    alt="sort"
                                />
                            </div>
                            <div class="text-center">
                                <span
                                    style="text-gray-700 text-base font-medium  leading-normal"
                                    >Sort by:
                                </span><span
                                    style="text-gray-700 text-base font-bold  leading-normal"
                                    >Highlight</span
                                >
                            </div>
                        </div>
                        <div
                            class="w-6 h-6 origin-top-left rotate-90 justify-center items-center flex"
                        >
                            <div class="w-6 h-6 relative"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div
                class="pt-5 grid grid-cols-1 gap-y-4 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-10 lg:grid-cols-2 lg:gap-x-4"
            >
                {
                    Products.map((product) => (
                        <div class="h-40 bg-white rounded-[10px] shadow justify-start items-start inline-flex">
                            <div class="w-40 h-40 p-2 justify-center items-center flex">
                                <a
                                    href={`/products/${product.attributes.slug}/`}
                                >
                                    <Image
                                        class="grow shrink basis-0 self-stretch rounded-md object-cover"
                                        src={`https://api.slmglobal.vn${product.attributes.feature_image.data.attributes.url}`}
                                        alt={product.attributes.title}
                                        inferSize
                                    />
                                </a>
                            </div>
                            <div class="grow shrink basis-0 px-4 py-3 flex-col justify-start items-start gap-1 inline-flex">
                                <a
                                    href={`/products/${product.attributes.slug}/`}
                                >
                                    <h1 class="self-stretch text-gray-700 text-sm leading-tight">
                                        {product.attributes.title}
                                    </h1>
                                </a>
                                {Array.isArray(product.attributes.highlight) &&
                                    product.attributes.highlight.map(
                                        (item: any) => (
                                            <div class="self-stretch text-gray-700 text-sm leading-tight">
                                                {item.title}:{item.value}
                                            </div>
                                        )
                                    )}

                                {/* <div class="self-stretch w-20 text-center p-1 rounded-md text-white bg-red-600 text-sm leading-tight">
                                    USD 100
                                </div> */}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

    <Certificate />
</Layout>
