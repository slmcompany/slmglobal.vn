---
import Layout from "../../layouts/Layout.astro";
import fetchApi from "../../lib/strapi.ts";
import type Products from "../../interfaces/products.ts";
import Image from "astro/components/Image.astro";
import Productmenu from "../../components/Productmenu.astro";
export async function getStaticPaths({}) {
    const Products: Array<Products> = await fetchApi({
        endpoint:
            "products?populate=feature_image&populate[0]=datasheet&populate[1]=datasheet.block_data", // the content type to fetch
        wrappedByKey: "data", // the key to unwrap the response
    });

    return Products.map((product: any) => ({
        params: { slug: product.attributes.slug },
        props: product,
    }));
}

const Products = Astro.props;
const baseUrl = import.meta.env.STRAPI_URL;

const menuItems = [
{
        title: "Thread Screw",
        imageSrc: "/images/uil_screw.svg",
        bgColor: "bg-red-500",
        textColor: "text-red-500",
        borderClass: "border-red-500",
        link: "/products/ground-screws",
    },
    {
        title: "Helical Screw",
        imageSrc: "/images/uil_screw.svg",
        bgColor: "bg-red-500",
        textColor: "text-red-500",
        borderClass: "border-red-500",
        link: "/products/ground-screws",
    },
];
---

<Layout title={Products.attributes.title}>
    <div class="bg-slate-100">
        <div class="pb-16 pt-6 sm:pb-24">
            <nav
                aria-label="Breadcrumb"
                class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 hidden sm:block"
            >
                <ol role="list" class="flex items-center space-x-4">
                    <li>
                        <div class="flex items-center">
                            <a
                                href="#"
                                class="mr-4 text-sm font-medium text-gray-900"
                                >Product</a
