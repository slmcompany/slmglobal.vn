                            <svg
                                viewBox="0 0 6 20"
                                aria-hidden="true"
                                class="h-5 w-auto text-gray-300"
                            >
                                <path
                                    d="M4.878 4.34H3.551L.27 16.532h1.327l3.281-12.19z"
                                    fill="currentColor"></path>
                            </svg>
                        </div>
                    </li>
                    <li>
                        <div class="flex items-center">
