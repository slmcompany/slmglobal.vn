                                >
                                    100 - 499 pieces
                                </div>
                            </div>
                            <div
                                class="flex-col justify-center items-start inline-flex"
                            >
                                <div
                                    class="justify-start items-start gap-1 inline-flex"
                                >
                                    <div
                                        class="flex-col justify-start items-end inline-flex"
                                    >
                                        <div
