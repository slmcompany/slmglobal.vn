---
import Layout from '../../../layouts/Layout.astro'

import Image from 'astro/components/Image.astro'

const Products = Astro.props
const baseUrl = import.meta.env.STRAPI_URL

const product = {
	title: 'MELAMINE PLYWOOD',
	description:
		'Melamine-coated Plywood is plywood with a melamine coating. Melamine is a thermosetting plastic that is scratch and water resistant, as well as fireproof.',
	specifications: [
		{
			title: ' ',
			length: 'Poplar/or as required',
			pipeSize: 'As required',
			weight: '2-25mm',
			surface: '1220 x 2440 x 2-40mm'
		}
	],
	connectionHead: [
		'/images/f-series-thread-screw-connect-head_1.png',
		'/images/f-series-thread-screw-connect-head_2.png',
		'/images/f-series-thread-screw-connect-head_3.png'
	],
	finishing: ['Squeeze', 'Covered, cut', 'Check quality'],
	accessories: ['Double-sided film', 'Waterproof, fire', 'Anti -chemical', 'Baled'],
	applications: ['Interior', 'Carriage', 'Industry '],
	mainImage: '/images/melamine-plywood/melamine-plywood-main.jpg',
	images: [
		'/images/melamine-plywood/melamine-plywood-1.jpg',
		'/images/melamine-plywood/melamine-plywood-2.jpg',
		'/images/melamine-plywood/melamine-plywood-3.jpg',
		'/images/melamine-plywood/melamine-plywood-4.jpg',
		'/images/melamine-plywood/melamine-plywood-5.jpg',
		'/images/melamine-plywood/melamine-plywood-6.jpg',
		'/images/melamine-plywood/melamine-plywood-7.jpg',
		'/images/melamine-plywood/melamine-plywood-8.jpg'
	]
}

const title = 'ProduThread Screw F Series'
---

<Layout title={product.title}>
	<div class="bg-white pt-14 sm:pt-10 md:pt-10 lg:pt-10">
		<div class="mx-auto max-w-7xl">
			<div class="flex flex-wrap">
				<div class="w-full px-2 md:w-6/12">
					<div class="w-full">
						<h2 class="text-2xl font-bold">{product.title}</h2>
						<p class="text-md text-justify text-gray-700">
							{product.description}
						</p>
						<div class="py-2">
							<img src={product.mainImage} class="aspect-[16/9] rounded-md object-cover" />
						</div>
						<div class="mt-4 overflow-x-auto">
							<table class="mt-4 min-w-full divide-y divide-gray-200">
								<thead class="bg-red-700">
									<tr class="p-2">
										<th scope="col" class="px-2 text-left uppercase tracking-wider text-white">
											Specifications
										</th>
										{
											product.specifications.map((spec) => (
												<th scope="col" class="text-left uppercase tracking-wider text-red-700">
													<span class="rounded-md px-2">{spec.title}</span>
												</th>
											))
										}
									</tr>
								</thead>
								<tbody class="divide-y divide-gray-200 bg-white">
									<tr>
										<td class="whitespace-nowrap text-gray-900">Ingredients</td>
										{
											product.specifications.map((spec) => (
												<td class="whitespace-nowrap">{spec.length}</td>
											))
										}
									</tr>
									<tr>
										<td class="whitespace-nowrap text-gray-900">Additives</td>
										{
											product.specifications.map((spec) => (
												<td class="whitespace-nowrap">{spec.pipeSize}</td>
											))
										}
									</tr>
									<tr>
										<td class="whitespace-nowrap text-gray-900">Extrusion temperature</td>
										{
											product.specifications.map((spec) => (
												<td class="whitespace-nowrap">{spec.weight}</td>
											))
										}
									</tr>
									<tr>
										<td class="whitespace-nowrap text-gray-900">Pressure</td>
										<td colspan={product.specifications.length} class="whitespace-nowrap">
											{product.specifications[0].weight}
										</td>
									</tr>
									<tr>
										<td class="whitespace-nowrap text-gray-900">Expression speed</td>
										<td colspan={product.specifications.length} class="whitespace-nowrap">
											{product.specifications[0].surface}
										</td>
									</tr>
								</tbody>
							</table>
						</div>
						<div class="mt-4 flex flex-wrap justify-between rounded-md bg-slate-100 p-2">
							<div class="w-full text-left md:w-1/3">
								<h2 class="font-bold text-red-700">Processing</h2>
								<ul class="list-inside list-disc text-base">
									{product.finishing.map((item, index) => <li>{item}</li>)}
								</ul>
							</div>
							<div class="w-full text-left md:w-1/3">
								<h2 class="font-bold text-red-700">Finishing</h2>
								<ul class="list-inside list-disc text-base">
									{product.accessories.map((item, index) => <li>{item}</li>)}
								</ul>
							</div>
							<div class="w-full text-left md:w-1/3">
								<h2 class="font-bold text-red-700">Applications</h2>
								<ul class="list-inside list-disc text-base">
									{product.applications.map((item, index) => <li>{item}</li>)}
								</ul>
							</div>
						</div>
					</div>
				</div>
				<div class="flex h-full w-full flex-wrap justify-start px-2 md:w-6/12">
					{
						product.images.map((image: any, index: number) => (
							<div class="w-1/2 p-2">
								<img src={image} class="aspect-[3/2] rounded-md object-cover" />
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</Layout>
