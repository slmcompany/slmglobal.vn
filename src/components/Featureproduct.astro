---
const { products, featuretitle } = Astro.props;
---

<div class="bg-slate-100 pb-28">
    <div class="pt-6 py-4">
        <div
            class="mx-auto mt-6 max-w-2xl xl:gap-4 md:max-w-2xl lg:max-w-4xl xl:mx-0 xl:max-w-none"
        >
         
            <h1 class="text-6xl max-w-7xl text-red-700 py-10 text-left ml-0 px-6 hidden lg:hidden sm:block">
                {featuretitle}
            </h1>
            <h1 class="text-6xl max-w-7xl text-red-700 py-10 text-center mx-auto block lg:block sm:hidden">
                {featuretitle}
            </h1>
           
        </div>
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <ul
                role="list"
                class="mx-auto mt-6 grid max-w-2xl grid-cols-1 xl:gap-4 gap-8 md:max-w-2xl md:grid-cols-2 lg:max-w-4xl xl:mx-0 xl:max-w-none xl:grid-cols-4"
            >
                {
                    products.map((product: any) => (
                        <li class="rounded-2xl bg-red-700 xl:px-4 xl:py-4 px-4 py-4">
                            <ul
                                role="list"
                                class="my-4 flex justify-between gap-x-2"
                            >
                                {/* <li>
                                        <ul
                                            role="list"
                                            class=" flex justify-between gap-x-1 "
                                        >
                                            <li>
                                                <button
                                                    type="button"
                                                    class={`inline-flex text-white `}
                                                >
                                                    text
                                                </button>
                                            </li>
                                            <li>
                                                <button
                                                    type="button"
                                                    class={`inline-flex items-center gap-x-1.5 rounded-lg px-2.5 py-1.5 xl:text-sm text-md font-semibold text-white shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2`}
                                                >
                                                   TExt
                                                </button>
                                            </li>
                                        </ul>
                                    </li> */}
                                <li>
                                    <button
                                        type="button"
                                        class="  px-2.5 py-1.5 xl:text-xl text-xl font-semibold "
                                    />
                                </li>
                            </ul>
                            <a href={product.link}>
                                <img
                                    class="rounded-2xl mx-auto aspect-[1/1] w-full "
                                    src={product.imageSrc}
                                    alt=""
                                />
                            </a>

                            <div class=" w-full rounded-md  text-center  py-1.5   ">
                                <h1
                                    class={`text-2xl text-white font-semibold `}
                                >
                                    {product.title}
                                </h1>
                            </div>
                            <div class="divide-y divide-gray-100 text-sm leading-6">
                                {product.highlight.map((highlight: any) => (
                                    <ul
                                        role="list"
                                        class="mt-2 flex justify-between gap-x-6"
                                    >
                                        <li>
                                            <h3 class="xl:text-lg text-xl  leading-7 tracking-tight">
                                                {highlight.text}
                                            </h3>
                                        </li>
                                        <li>
                                            <p class="xl:text-lg text-xl text-right  leading-6">
                                                {highlight.value}
                                            </p>
                                        </li>
                                    </ul>
                                ))}
                            </div>
                            {/* <ul
                                role="list"
                                class="mt-6 flex justify-between  gap-x-3"
                            >
                                <li class="w-2/3">
                                    <a href={`/`}>
                                        <button
                                            type="button"
                                            class="bg-white border-red-600 w-full xl:text-lg text-red-600 inline-flex items-center gap-x-1.5 rounded-xl border-2 px-2.5 py-1.5 text-lg font-semibold justify-center"
                                        >
                                            {product.price}
                                        </button>
                                    </a>
                                </li>
                                <li class="w-full">
                                    <a href={product.link}>
                                        <button
                                            type="button"
                                            class="w-full xl:text-lg bg-red-600 inline-flex items-center gap-x-1.5 rounded-xl border-2 px-2 py-1.5 text-lg font-semibold text-white justify-center"
                                        >
                                           
                                           {product.price}
                                        </button>
                                    </a>
                                </li>
                            </ul> */}
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</div>
