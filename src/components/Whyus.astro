---
const whyitem = [
    {
        title: "Made in Vietnam, made by Vietnamese",
        imageSrc: "/images/why-us-1.png",
    },
    {
        title: "years export experience",
        imageSrc: "/images/why-us-2.png",
    },
    {
        title: "3 factories including Hot-dip galvanizing, mechanical and rubber",
        imageSrc: "/images/why-us-3.png",
    },
    {
        title: "Export to European markets, America, Norway, Sweden, Australia",
        imageSrc: "/images/why-us-4.png",
    },
];
---

<div class="bg-red-600 py-10 sm:py-32 lg:hidden">
    <div
        class="mx-auto grid max-w-7xl gap-x-8 gap-y-12 px-6 lg:px-8 xl:grid-cols-2"
    >
        <div class="max-w-2xl">
            <h1
                class="text-6xl font-bold tracking-tight text-wwhite sm:text-4xl"
            >
                Why us ?
            </h1>
        </div>
        <ul
            role="list"
            class="grid gap-x-4 gap-y-2 sm:grid-cols-2 xl:grid-cols-1  sm:gap-y-16 xl:col-span-2"
        >
            {
                whyitem.map((item) => (
                    <li class="py-2">
                        <div class="flex items-center gap-x-6 bg-gray-100 shadow-md rounded-md px-2">
                            <img
                                class="h-30 w-30 "
                                src={item.imageSrc}
                                alt=""
                            />
                            <div>
                                <h2 class="text-xl font-semibold leading-7 tracking-tight text-gray-900">
                                    {item.title}
                                </h2>
                            </div>
                        </div>
                    </li>
                    
                ))
            }

            <!-- More people... -->
        </ul>
    </div>
</div>
